{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLADE",
  "version": "0.2.3",
  "identifier": "com.dad2lna.brokesched",
  "build": {
    "beforeDevCommand": "node scripts/copy-frontend.js",
    "beforeBuildCommand": "node scripts/copy-frontend.js",
    "frontendDist": "../dist-frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BLADE Alpha Build",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
